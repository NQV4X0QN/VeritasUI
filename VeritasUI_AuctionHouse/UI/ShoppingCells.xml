<Ui xmlns="http://www.blizzard.com/wow/ui/">
  <!--
    VeritasUI_AuctionHouse / UI/ShoppingCells.xml
    Clean-room cell templates for the Shopping tab's results table, driven by
    Blizzard's native TableBuilder (CreateTableBuilder). TableBuilder pools cell
    frames by template NAME, which requires XML-registered virtual templates. This
    is the standard native UI authoring path (Blizzard's own AH cells live in
    Blizzard_AuctionHouseTableBuilder.xml; we define our own equivalents here,
    modern and minimal, rather than depend on AH-internal templates).

    Each cell mixin implements the TableBuilder cell contract: an Init method
    (one-time, receives the column's cellParameters) and a Populate method
    (per row, binds data). Three cell types cover our columns:
      VUIAHTextCell   plain left text (Available); Init(fieldName)
      VUIAHMoneyCell  native coin display (Price, Scanned); Init(fieldName)
      VUIAHItemCell   icon plus quality-colored name (Name); reads itemKey
  -->

  <!-- Plain text cell -->
  <Frame name="VUIAHTextCellTemplate" mixin="VUIAHTextCellMixin" virtual="true">
    <Size x="0" y="16"/>
    <Layers>
      <Layer level="BACKGROUND">
        <FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Anchors>
            <Anchor point="LEFT" x="6" y="0"/>
            <Anchor point="RIGHT" x="0" y="0"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>

  <!-- Money cell: native MoneyDisplayFrame with AH coin icons. Right-justified (the
       default, no leftAlign) but anchored with a right-edge margin so the coins don't
       jam against the column edge — matches native's Price/buyout columns. -->
  <Frame name="VUIAHMoneyCellTemplate" mixin="VUIAHMoneyCellMixin" virtual="true">
    <Size x="0" y="16"/>
    <Frames>
      <Frame parentKey="MoneyDisplay" inherits="MoneyDisplayFrameTemplate">
        <KeyValues>
          <KeyValue key="useAuctionHouseCopperValue" value="true" type="boolean"/>
          <KeyValue key="useAuctionHouseIcons" value="true" type="boolean"/>
        </KeyValues>
        <Anchors>
          <Anchor point="RIGHT" x="-12" y="0"/>
        </Anchors>
      </Frame>
    </Frames>
  </Frame>

  <!-- Item cell: icon + quality-colored name -->
  <Frame name="VUIAHItemCellTemplate" mixin="VUIAHItemCellMixin" virtual="true">
    <Size x="0" y="18"/>
    <Layers>
      <Layer level="ARTWORK">
        <Texture parentKey="Icon">
          <Size x="16" y="16"/>
          <Anchors>
            <Anchor point="LEFT" x="6" y="0"/>
          </Anchors>
        </Texture>
      </Layer>
      <Layer level="BACKGROUND">
        <FontString parentKey="Text" inherits="GameFontHighlightSmall" justifyH="LEFT">
          <Anchors>
            <Anchor point="LEFT" relativeKey="$parent.Icon" relativePoint="RIGHT" x="4" y="0"/>
            <Anchor point="RIGHT" x="0" y="0"/>
          </Anchors>
        </FontString>
      </Layer>
    </Layers>
  </Frame>
  <!-- Left detail-pane money display (Unit/Total price). Left-justified with AH copper
       rounding + AH coin icons applied via KeyValues BEFORE OnLoad — which is what makes
       a zero coin-part omit ("5s", not "5s 0c"). Setting these flags in Lua after
       CreateFrame is too late, so this template exists to get the native zero-eliding. -->
  <Frame name="VUIAHPanelMoneyTemplate" inherits="MoneyDisplayFrameTemplate" virtual="true">
    <KeyValues>
      <KeyValue key="useAuctionHouseCopperValue" value="true" type="boolean"/>
      <KeyValue key="useAuctionHouseIcons" value="true" type="boolean"/>
      <KeyValue key="leftAlign" value="true" type="boolean"/>
    </KeyValues>
  </Frame>
  <!-- Right-aligned row money (auction list price column). Same AH copper/icons + zero-
       eliding KeyValues as the panel template, but WITHOUT leftAlign so it right-justifies. -->
  <Frame name="VUIAHRowMoneyTemplate" inherits="MoneyDisplayFrameTemplate" virtual="true">
    <KeyValues>
      <KeyValue key="useAuctionHouseCopperValue" value="true" type="boolean"/>
      <KeyValue key="useAuctionHouseIcons" value="true" type="boolean"/>
    </KeyValues>
  </Frame>
  <!-- Modern AH quantity input box. Three-slice atlas border (Left/Middle/Right =
       auctionhouse-ui-inputfield-{left,middle,right}, verified native). All three slices
       anchor to the editbox TOP+BOTTOM so they share ONE height (the editbox's) — using
       useAtlasSize forced their native height instead, misaligning the slices. -->
  <EditBox name="VUIAHInputBoxTemplate" virtual="true" autoFocus="false">
    <Layers>
      <Layer level="BACKGROUND">
        <Texture parentKey="Left" atlas="auctionhouse-ui-inputfield-left">
          <Size x="8" y="0"/>
          <Anchors>
            <Anchor point="TOPLEFT"/>
            <Anchor point="BOTTOMLEFT"/>
          </Anchors>
        </Texture>
        <Texture parentKey="Right" atlas="auctionhouse-ui-inputfield-right">
          <Size x="8" y="0"/>
          <Anchors>
            <Anchor point="TOPRIGHT"/>
            <Anchor point="BOTTOMRIGHT"/>
          </Anchors>
        </Texture>
        <Texture parentKey="Middle" atlas="auctionhouse-ui-inputfield-middle">
          <Anchors>
            <Anchor point="TOPLEFT" relativeKey="$parent.Left" relativePoint="TOPRIGHT"/>
            <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Right" relativePoint="BOTTOMLEFT"/>
          </Anchors>
        </Texture>
      </Layer>
    </Layers>
    <FontString inherits="ChatFontNormal"/>
    <Scripts>
      <OnEscapePressed>self:ClearFocus()</OnEscapePressed>
    </Scripts>
  </EditBox>
</Ui>
